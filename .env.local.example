### Copy this file to .env.local and fill in your keys (do NOT commit .env.local)

# Google reCAPTCHA v2 (checkbox)
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# Example: add localhost and 127.0.0.1 as allowed domains when creating the keys in Google reCAPTCHA admin.
