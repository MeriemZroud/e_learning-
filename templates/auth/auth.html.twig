{% extends 'base.html.twig' %}

{% block title %}LearnWay Auth{% endblock %}

{% block body %}
<main class="auth-shell">
    <section class="auth-visual" aria-hidden="true">
        <img src="{{ asset('image_clean.png') }}" alt="LearnWay" class="auth-visual__image">
        <div class="auth-visual__overlay">
            <h1>LearnWay</h1>
            <p>Learn. Verify. Access the right space.</p>
        </div>
    </section>

    <section class="auth-panel">
        <div class="auth-card">
            <div class="auth-card__header">
                <h2>Welcome to LearnWay</h2>
                <p>Sign in or create your account to continue as an administrator, teacher, or student.</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="auth-alert {% if label == 'error' %}auth-alert--error{% endif %}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <div class="auth-tabs">
                <a href="{{ path('app_login') }}" class="{% if active_tab == 'login' %}active{% endif %}">Login</a>
                <a href="{{ path('app_register') }}" class="{% if active_tab == 'register' %}active{% endif %}">Register</a>
            </div>

            {% if active_tab == 'login' %}
                <form class="auth-form" method="post" action="{{ path('app_login') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('authenticate') }}">

                    {% if error %}
                        <div class="auth-alert auth-alert--error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <div class="auth-field">
                        <label for="email">Email Address</label>
                        <input id="email" type="email" name="email" value="{{ last_username }}" placeholder="Enter your email address" required autofocus>
                    </div>

                    <div class="auth-field auth-password">
                        <label for="password">Password</label>
                        <input id="password" type="password" name="password" placeholder="Enter your password" required>
                        <span class="auth-password__icon">◔</span>
                    </div>

                    <p style="margin: -0.15rem 0 0; text-align: right;">
                        <a class="auth-small-link" href="{{ path('app_forgot_password') }}">Forgot your password?</a>
                    </p>

                    <div style="margin-top:0.75rem;">
                        <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}"></div>
                    </div>
                    <button class="auth-submit" type="submit">Login</button>
                </form>
            {% else %}
                <form class="auth-form" method="post" action="{{ path('app_register') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('register') }}">

                    {% if error %}
                        <div class="auth-alert auth-alert--error">{{ error }}</div>
                    {% endif %}

                    <div class="auth-form__grid">
                        <div class="auth-field">
                            <label for="first_name">First name</label>
                            <input id="first_name" type="text" name="first_name" value="{{ form_data.first_name|default('') }}" placeholder="Enter your first name" required>
                        </div>

                        <div class="auth-field">
                            <label for="last_name">Last name</label>
                            <input id="last_name" type="text" name="last_name" value="{{ form_data.last_name|default('') }}" placeholder="Enter your last name" required>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label for="register_email">Email Address</label>
                        <input id="register_email" type="email" name="email" value="{{ form_data.email|default('') }}" placeholder="Enter your email address" required>
                    </div>

                    <div class="auth-field">
                        <label for="role">Role</label>
                        <select id="role" name="role" required>
                            <option value="student" {% if form_data.role|default('student') == 'student' %}selected{% endif %}>Student</option>
                            <option value="teacher" {% if form_data.role|default('student') == 'teacher' %}selected{% endif %}>Teacher</option>
                            <option value="admin" {% if form_data.role|default('student') == 'admin' %}selected{% endif %}>Admin</option>
                        </select>
                    </div>

                    <div class="auth-form__grid">
                        <div class="auth-field auth-password">
                            <label for="register_password">Password</label>
                            <input id="register_password" type="password" name="password" placeholder="Enter your password" required>
                            <span class="auth-password__icon">◔</span>
                        </div>

                        <div class="auth-field auth-password">
                            <label for="password_confirmation">Confirm password</label>
                            <input id="password_confirmation" type="password" name="password_confirmation" placeholder="Confirm your password" required>
                            <span class="auth-password__icon">◔</span>
                        </div>
                    </div>

                    <div style="margin-top:0.75rem;">
                        <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}"></div>
                    </div>
                    <button class="auth-submit" type="submit">Register</button>
                </form>
            {% endif %}
        </div>
    </section>
</main>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endblock %}