{% extends 'base.html.twig' %}

{% block title %}Verify code{% endblock %}

{% block body %}
<main class="auth-verify">
    <div class="auth-verify__card">
        <div class="auth-card__header">
            <h2>Verification code</h2>
            <p>We sent a code to <strong>{{ email }}</strong>. Enter it below to activate your account.</p>
        </div>

        {% if mail_failed and verification_code %}
            <div class="auth-alert">
                Email delivery is unavailable right now. Use this code to continue: <strong>{{ verification_code }}</strong>
            </div>
        {% endif %}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="auth-alert {% if label == 'error' %}auth-alert--error{% endif %}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% if error %}
            <div class="auth-alert auth-alert--error">{{ error }}</div>
        {% endif %}

        <form class="auth-form" method="post" action="{{ path('app_verify_code') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('verify_code') }}">

            <div class="auth-field">
                <label for="verification_code">Verification code</label>
                <input id="verification_code" type="text" name="verification_code" inputmode="numeric" maxlength="6" placeholder="Enter the 6-digit code" required autofocus>
            </div>

            <button class="auth-submit" type="submit">Verify account</button>
        </form>

        <p style="margin-top: 1rem; color: var(--muted); text-align: center;">
            Already verified? <a class="auth-small-link" href="{{ path('app_login') }}">Go to login</a>
        </p>
    </div>
</main>
{% endblock %}