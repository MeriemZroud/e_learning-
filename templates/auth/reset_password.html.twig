{% extends 'base.html.twig' %}

{% block title %}Reset password{% endblock %}

{% block body %}
<main class="auth-verify">
    <div class="auth-verify__card">
        <div class="auth-card__header">
            <h2>Reset password</h2>
            <p>Choose a new password to access your account again.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="auth-alert {% if label == 'error' %}auth-alert--error{% endif %}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% if error %}
            <div class="auth-alert auth-alert--error">{{ error }}</div>
        {% endif %}

        <form class="auth-form" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">

            <div class="auth-field auth-password">
                <label for="password">New password</label>
                <input id="password" type="password" name="password" placeholder="At least 8 characters" required autofocus>
                <span class="auth-password__icon">◔</span>
            </div>

            <div class="auth-field auth-password">
                <label for="password_confirmation">Confirm password</label>
                <input id="password_confirmation" type="password" name="password_confirmation" placeholder="Re-enter your new password" required>
                <span class="auth-password__icon">◔</span>
            </div>

            <button class="auth-submit" type="submit">Update password</button>
        </form>

        <p style="margin-top: 1rem; color: var(--muted); text-align: center;">
            Back to <a class="auth-small-link" href="{{ path('app_login') }}">login</a>
        </p>
    </div>
</main>
{% endblock %}
