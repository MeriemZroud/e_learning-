{% extends 'base.html.twig' %}

{% block title %}Forgot password{% endblock %}

{% block body %}
<main class="auth-verify">
    <div class="auth-verify__card">
        <div class="auth-card__header">
            <h2>Forgot password</h2>
            <p>Enter your email address and we will send you a reset link.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="auth-alert {% if label == 'error' %}auth-alert--error{% endif %}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% if error %}
            <div class="auth-alert auth-alert--error">{{ error }}</div>
        {% endif %}

        <form class="auth-form" method="post" action="{{ path('app_forgot_password') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('forgot_password_request') }}">

            <div class="auth-field">
                <label for="email">Email address</label>
                <input id="email" type="email" name="email" value="{{ email }}" placeholder="Enter your email address" required autofocus>
            </div>

            <button class="auth-submit" type="submit">Send reset link</button>
        </form>

        <p style="margin-top: 1rem; color: var(--muted); text-align: center;">
            Back to <a class="auth-small-link" href="{{ path('app_login') }}">login</a>
        </p>
    </div>
</main>
{% endblock %}
