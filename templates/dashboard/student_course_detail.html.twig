{% extends 'base.html.twig' %}

{% block title %}Course Detail{% endblock %}

{% block body %}
{% set chatbotToken = csrf_token('student_course_chatbot_' ~ course.id) %}
{% set chatbotAvatar = asset('chatbot.png') %}
{% set userAvatar = (app.user and app.user.profileImage) ? asset('uploads/profile/' ~ app.user.profileImage) : asset('profil.jpg') %}
<main class="student-home student-forum-page student-course-detail-page">
    <div class="student-home__container">
        <header class="student-topbar">
            <a class="student-logo" href="{{ path('app_student_dashboard') }}">LearnWay</a>
            <nav class="student-nav" aria-label="Main navigation">
                <a href="{{ path('app_student_dashboard') }}">Home</a>
                <a href="{{ path('app_student_quiz_index') }}" class="is-active">Course</a>
                <a href="#">Career</a>
                <a href="{{ path('app_student_forum_index') }}">Blog</a>
                <a href="{{ path('app_student_profile') }}">Profile</a>
                <a href="{{ path('app_student_about') }}">About us</a>
                <a href="{{ path('app_reclamation_index') }}">Reclamations</a>
            </nav>
            <div class="student-topbar__actions">
                {% include 'partials/_language_selector.html.twig' %}
                <div class="student-user">
                {% if app.user and app.user.profileImage %}
                    <img class="student-user__avatar student-user__avatar-image" src="{{ asset('uploads/profile/' ~ app.user.profileImage) }}" alt="{{ student_name }} avatar">
                {% else %}
                    <span class="student-user__avatar">{{ student_name|slice(0, 1)|upper }}</span>
                {% endif %}
                <span class="student-user__name">{{ student_name }}</span>
                </div>
            </div>
        </header>

        {% set videoUrl = course.videoUrl %}
        {% if 'youtube.com/watch?v=' in course.videoUrl %}
            {% set videoUrl = course.videoUrl|replace({'watch?v=': 'embed/'}) %}
        {% elseif 'youtu.be/' in course.videoUrl %}
            {% set videoCode = (course.videoUrl|split('youtu.be/')|last)|split('?')|first %}
            {% set videoUrl = 'https://www.youtube.com/embed/' ~ videoCode %}
        {% endif %}

        <section class="student-forum-hero">
            <div>
                <p class="student-forum-hero__kicker">Course detail</p>
                <h1>{{ course.title }}</h1>
                <p>{{ course.description|default('No description provided yet.') }}</p>
            </div>
            <a class="student-btn" href="{{ path('app_student_quiz_index') }}">Back to course list</a>
        </section>

        <section class="student-section student-section--soft">
            <div class="student-live-course">
                <article class="student-live-course__video">
                    {% if 'youtube.com/embed/' in videoUrl %}
                        <iframe
                            src="{{ videoUrl }}"
                            title="{{ course.title }}"
                            loading="lazy"
                            allowfullscreen>
                        </iframe>
                    {% else %}
                        <video controls preload="metadata" src="{{ videoUrl }}"></video>
                    {% endif %}
                </article>

                <article class="student-live-course__info">
                    <p class="student-related-card__tag">Learning resources</p>
                    <h3>{{ course.title }}</h3>
                    <p>{{ course.description|default('No description available.') }}</p>
                    <div class="student-live-course__links">
                        <a class="student-btn student-btn--primary" href="{{ course.videoUrl }}" target="_blank" rel="noopener">Open video</a>
                        {% if course.pdfFile %}
                            <a class="student-btn" href="{{ asset('uploads/courses/pdf/' ~ course.pdfFile) }}" target="_blank" rel="noopener">Open PDF</a>
                        {% endif %}
                    </div>
                </article>
            </div>
        </section>

        <div class="student-course-two-columns">
        <section class="student-section student-section--soft student-course-two-columns__summary">
            <div class="student-section__head">
                <h2>Automatic Lesson Summary</h2>
            </div>

            <article class="student-related-card">
                <div class="student-related-card__content">
                    <p class="student-related-card__tag">IA Study Helper</p>
                    <h3>Short Summary + Key Revision Points</h3>
                    <p>Generate a condensed version of this lesson and key points to review before the quiz.</p>

                    <div class="student-live-course__links">
                        <a class="student-btn student-btn--primary" href="{{ path('app_student_course_lesson_summary', {id: course.id}) }}">Generate AI Summary</a>
                        <a class="student-btn" href="{{ path('app_student_course_lesson_summary_pdf', {id: course.id}) }}">Download PDF</a>
                    </div>

                    {% if lesson_summary %}
                        <div style="margin-top:1rem;padding:0.9rem 1rem;border-radius:14px;background:#f2fbfb;border:1px solid #d8ecec;">
                            <p class="student-related-card__tag" style="margin-bottom:0.4rem;">Summary</p>
                            <p style="margin-bottom:0.8rem;">{{ lesson_summary.summary }}</p>

                            <p class="student-related-card__tag" style="margin-bottom:0.4rem;">Key Revision Points</p>
                            <ul style="margin:0 0 0 1rem;padding:0;display:grid;gap:0.35rem;">
                                {% for point in lesson_summary.keyPoints %}
                                    <li>{{ point }}</li>
                                {% endfor %}
                            </ul>

                            <p style="margin-top:0.8rem;font-size:0.86rem;color:#4f6a70;">Model: {{ lesson_summary.model }}</p>
                        </div>
                    {% endif %}
                </div>
            </article>
        </section>

        <section class="student-section student-course-two-columns__quizzes">
            <div class="student-section__head">
                <h2>Course quizzes</h2>
            </div>

            {% if quizzes is empty %}
                <article class="student-related-card">
                    <div class="student-related-card__content">
                        <h3>No quiz published yet</h3>
                        <p>Your teacher has not published quizzes for this course.</p>
                    </div>
                </article>
            {% else %}
                <div class="teacher-quiz-list">
                    {% for quiz in quizzes %}
                        {% set submission = submission_map[quiz.id] ?? null %}
                        <article class="student-related-card teacher-quiz-card">
                            <div class="student-related-card__content">
                                <p class="student-related-card__tag">Quiz</p>
                                <h3>{{ quiz.title }}</h3>
                                <p>{{ quiz.sourceSummary|default('Quiz generated from course resources.') }}</p>
                                <div class="teacher-quiz-card__footer">
                                    <div class="teacher-quiz-index-meta">
                                        <span>Published: {{ quiz.createdAt ? quiz.createdAt|date('d/m/Y') : '-' }}</span>
                                        {% if submission and submission.score is not null %}
                                            <strong>Score: {{ submission.score }}/20</strong>
                                        {% endif %}
                                    </div>
                                    <a class="student-btn student-btn--primary" href="{{ path('app_student_quiz_take', {id: quiz.id}) }}">
                                        {% if submission %}Retake{% else %}Start quiz{% endif %}
                                    </a>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
        </div>

        <div
            class="student-course-chatbot"
            data-course-chatbot
            data-chat-endpoint="{{ path('app_student_course_chatbot', {id: course.id}) }}"
            data-chat-token="{{ chatbotToken }}"
            data-chatbot-avatar="{{ chatbotAvatar }}"
            data-user-avatar="{{ userAvatar }}"
        >
            <button class="student-course-chatbot__toggle" type="button" aria-label="Open course assistant" aria-expanded="false">
                <img src="{{ chatbotAvatar }}" alt="Chatbot assistant">
            </button>

            <section class="student-course-chatbot__panel" hidden>
                <header class="student-course-chatbot__head">
                    <h3>Course Assistant</h3>
                    <button class="student-course-chatbot__close" type="button" aria-label="Close assistant">×</button>
                </header>

                <div class="student-course-chatbot__messages" aria-live="polite">
                    <article class="student-course-chatbot__message student-course-chatbot__message--assistant">
                        <img class="student-course-chatbot__avatar" src="{{ chatbotAvatar }}" alt="Chatbot">
                        <p class="student-course-chatbot__bubble">Hi! I can help you understand this course and prepare for quizzes.</p>
                    </article>
                </div>

                <form class="student-course-chatbot__form">
                    <label class="sr-only" for="student-course-chatbot-input">Your message</label>
                    <textarea id="student-course-chatbot-input" name="message" rows="2" placeholder="Ask your question..." required></textarea>
                    <button type="submit" class="student-btn student-btn--primary">Send</button>
                </form>
            </section>
        </div>
    </div>
</main>

<script>
(() => {
    const root = document.querySelector('[data-course-chatbot]');
    if (!root) {
        return;
    }

    const endpoint = root.dataset.chatEndpoint;
    const token = root.dataset.chatToken;
    const chatbotAvatar = root.dataset.chatbotAvatar;
    const userAvatar = root.dataset.userAvatar;
    const toggleButton = root.querySelector('.student-course-chatbot__toggle');
    const closeButton = root.querySelector('.student-course-chatbot__close');
    const panel = root.querySelector('.student-course-chatbot__panel');
    const form = root.querySelector('.student-course-chatbot__form');
    const textarea = form?.querySelector('textarea[name="message"]');
    const messages = root.querySelector('.student-course-chatbot__messages');

    if (!endpoint || !token || !chatbotAvatar || !userAvatar || !toggleButton || !closeButton || !panel || !form || !textarea || !messages) {
        return;
    }

    const history = [];

    const appendMessage = (text, role) => {
        const messageNode = document.createElement('article');
        messageNode.className = `student-course-chatbot__message student-course-chatbot__message--${role}`;

        const avatarNode = document.createElement('img');
        avatarNode.className = 'student-course-chatbot__avatar';
        avatarNode.src = role === 'assistant' ? chatbotAvatar : userAvatar;
        avatarNode.alt = role === 'assistant' ? 'Chatbot' : 'User';

        const bubbleNode = document.createElement('p');
        bubbleNode.className = 'student-course-chatbot__bubble';
        bubbleNode.textContent = text;

        messageNode.appendChild(avatarNode);
        messageNode.appendChild(bubbleNode);
        messages.appendChild(messageNode);
        messages.scrollTop = messages.scrollHeight;
    };

    const setPanelOpen = (open) => {
        panel.hidden = !open;
        toggleButton.setAttribute('aria-expanded', open ? 'true' : 'false');
        root.classList.toggle('is-open', open);
        if (open) {
            textarea.focus();
        }
    };

    toggleButton.addEventListener('click', () => {
        setPanelOpen(panel.hidden);
    });

    closeButton.addEventListener('click', () => {
        setPanelOpen(false);
    });

    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const text = textarea.value.trim();
        if (!text) {
            return;
        }

        appendMessage(text, 'user');
        history.push({ role: 'user', content: text });
        textarea.value = '';
        textarea.disabled = true;

        const submitButton = form.querySelector('button[type="submit"]');
        if (submitButton) {
            submitButton.disabled = true;
        }

        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': token,
                },
                body: JSON.stringify({
                    message: text,
                    history,
                }),
            });

            let data = null;
            try {
                data = await response.json();
            } catch (parseError) {
                data = null;
            }

            if (!response.ok) {
                const apiError = typeof data?.error === 'string' && data.error.trim() !== ''
                    ? data.error.trim()
                    : 'I could not generate an answer right now. Please try again.';

                appendMessage(apiError, 'assistant');
                history.push({ role: 'assistant', content: apiError });
                return;
            }

            const answer = typeof data?.answer === 'string' && data.answer.trim() !== ''
                ? data.answer.trim()
                : (typeof data?.error === 'string' && data.error.trim() !== ''
                    ? data.error.trim()
                    : 'I could not generate an answer right now. Please try again.');

            appendMessage(answer, 'assistant');
            history.push({ role: 'assistant', content: answer });
        } catch (error) {
            appendMessage('Unable to reach the assistant right now. Please try again in a moment.', 'assistant');
        } finally {
            textarea.disabled = false;
            textarea.focus();

            if (submitButton) {
                submitButton.disabled = false;
            }
        }
    });
})();
</script>
{% endblock %}
