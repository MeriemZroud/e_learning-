{% extends 'base.html.twig' %}

{% block title %}About LearnWay{% endblock %}

{% block body %}
<main class="student-home student-about-page">
    <div class="student-home__container">
        <header class="student-topbar">
            <a class="student-logo" href="{{ path('app_student_dashboard') }}">LearnWay</a>
            <nav class="student-nav" aria-label="Main navigation">
                <a href="{{ path('app_student_dashboard') }}">Home</a>
                <a href="{{ path('app_student_quiz_index') }}">Course</a>
                <a href="#">Career</a>
                <a href="{{ path('app_student_forum_index') }}">Blog</a>
                <a href="{{ path('app_student_profile') }}">Profile</a>
                <a href="{{ path('app_student_about') }}" class="is-active">About us</a>
                <a href="{{ path('app_reclamation_index') }}">Reclamations</a>
            </nav>
            <div class="student-topbar__actions">
                {% include 'partials/_language_selector.html.twig' %}
                <div class="student-user">
                    {% if app.user and app.user.profileImage %}
                        <img class="student-user__avatar student-user__avatar-image" src="{{ asset('uploads/profile/' ~ app.user.profileImage) }}" alt="{{ student_name }} avatar">
                    {% else %}
                        <span class="student-user__avatar">{{ student_name|slice(0, 1)|upper }}</span>
                    {% endif %}
                    <span class="student-user__name">{{ student_name }}</span>
                </div>

                <div class="student-notifications">
                    <button
                        class="student-notifications__button"
                        type="button"
                        aria-label="Notifications"
                        aria-expanded="false"
                        id="notifications-toggle"
                    >
                        <span class="student-notifications__emoji" aria-hidden="true">
                            <svg class="student-notifications__icon" viewBox="0 0 24 24" fill="none" focusable="false">
                                <path d="M15 17H9m9-1V11a6 6 0 10-12 0v5l-2 2h16l-2-2zm-8 2a2 2 0 104 0" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                            </svg>
                        </span>
                        {% if unreadNotifications is not empty %}
                            <span class="student-notifications__badge">{{ unreadNotifications|length }}</span>
                        {% endif %}
                    </button>

                    <section class="student-notifications-panel" id="notifications-panel" aria-hidden="true">
                        <div class="student-notifications-panel__header">
                            <span class="student-notifications-panel__title">Notifications</span>
                            <span class="student-notifications-panel__count">{{ unreadNotifications|length }} new</span>
                        </div>
                        <div class="student-notifications-panel__list">
                            {% for notification in unreadNotifications %}
                                <article class="student-notifications-panel__item">
                                    <strong>{{ notification.type|default('info')|replace({'_':' '})|title }}</strong>
                                    <p>{{ notification.message }}</p>
                                    <small>{{ notification.createdAt ? notification.createdAt|date('d/m/Y H:i') : '' }}</small>
                                </article>
                            {% else %}
                                <article class="student-notifications-panel__item student-notifications-panel__item--empty">
                                    <p>No new notifications.</p>
                                </article>
                            {% endfor %}
                        </div>
                    </section>
                </div>
            </div>
        </header>

        <section class="student-hero">
            <div class="student-hero__text">
                <p class="student-hero__meta">About LearnWay</p>
                <h1>Learning designed for students who want to move faster and learn better.</h1>
                <p class="student-hero__desc">
                    LearnWay is an e-learning platform built to help students follow structured lessons,
                    join conversations, and track their progress in one place with a clean and friendly interface.
                </p>
                <div class="student-hero__actions">
                    <a class="student-btn student-btn--primary" href="{{ path('app_student_dashboard') }}">Back to dashboard</a>
                    <a class="student-btn" href="{{ path('app_student_forum_index') }}">Visit forum</a>
                </div>
            </div>
            <div class="student-hero__visual">
                <img
                    src="{{ asset('about.png') }}"
                    alt="LearnWay e-learning"
                    class="student-hero__image"
                    onerror="this.onerror=null;this.src='{{ asset('about.jpg') }}';"
                >
            </div>
        </section>

        <section class="student-section">
            <div class="student-section__head">
                <h2>What LearnWay offers</h2>
            </div>
            <div class="student-mini-grid">
                <article class="student-mini-card">
                    <img src="{{ asset('stucture.jpg') }}" alt="Structure" class="student-mini-card__image">
                    <h3>Structured lessons</h3>
                </article>
                <article class="student-mini-card">
                    <img src="{{ asset('prog.jpg') }}" alt="Progress" class="student-mini-card__image">
                    <h3>Progress tracking</h3>
                </article>
                <article class="student-mini-card">
                    <img src="{{ asset('forum.jpg') }}" alt="Forum" class="student-mini-card__image">
                    <h3>Student forum</h3>
                </article>
                <article class="student-mini-card">
                    <img src="{{ asset('profil.jpg') }}" alt="Profile" class="student-mini-card__image">
                    <h3>Personal profile</h3>
                </article>
            </div>
        </section>

        <section class="student-section student-section--soft">
            <div class="student-section__head">
                <h2>Why students use LearnWay</h2>
            </div>
            <div class="student-related-grid">
                <article class="student-related-card" style="--card-image: url('{{ asset('focus.jpg') }}');">
                    <div class="student-related-card__image"></div>
                    <div class="student-related-card__content">
                        <p class="student-related-card__tag">Focused learning</p>
                        <h3>Content stays organized by subject, so students can learn step by step.</h3>
                        <p>Each lesson is meant to be clear, practical, and easy to revisit whenever needed.</p>
                    </div>
                </article>
                <article class="student-related-card" style="--card-image: url('{{ asset('for.jpg') }}');">
                    <div class="student-related-card__image"></div>
                    <div class="student-related-card__content">
                        <p class="student-related-card__tag">Community support</p>
                        <h3>Students can share ideas, ask questions, and stay connected through the forum.</h3>
                        <p>LearnWay combines course material with discussion spaces to keep learning active.</p>
                    </div>
                </article>
            </div>
        </section>

        <section class="student-section">
            <div class="student-section__head">
                <h2>Our promise</h2>
            </div>
            <div class="student-workshop-grid">
                <article class="student-workshop-card" style="--card-image: url('{{ asset('naviagtion.jpg') }}');">
                    <div class="student-workshop-card__image"></div>
                    <h3>Simple navigation</h3>
                    <p>Students can move between learning, profile, and discussions without friction.</p>
                </article>
                <article class="student-workshop-card" style="--card-image: url('{{ asset('progression.jpg') }}');">
                    <div class="student-workshop-card__image"></div>
                    <h3>Clear progress</h3>
                    <p>We focus on helping learners see what they have completed and what comes next.</p>
                </article>
                <article class="student-workshop-card" style="--card-image: url('{{ asset('Supportive experience.jpg') }}');">
                    <div class="student-workshop-card__image"></div>
                    <h3>Supportive experience</h3>
                    <p>LearnWay is designed to feel welcoming, calm, and easy to use every day.</p>
                </article>
                <article class="student-workshop-card" style="--card-image: url('{{ asset('Built for growth.jpg') }}');">
                    <div class="student-workshop-card__image"></div>
                    <h3>Built for growth</h3>
                    <p>The platform is ready for lessons, collaboration, and future student features.</p>
                </article>
            </div>
        </section>

        <footer class="student-footer">
            <p class="student-footer__brand">LearnWay</p>
            <p>Learn online. Stay connected. Grow with confidence.</p>
            <small>About LearnWay e-learning platform</small>
        </footer>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const notificationsToggle = document.getElementById('notifications-toggle');
            const notificationsPanel = document.getElementById('notifications-panel');

            if (notificationsToggle && notificationsPanel) {
                const closePanel = function() {
                    notificationsPanel.classList.remove('is-visible');
                    notificationsPanel.setAttribute('aria-hidden', 'true');
                    notificationsToggle.setAttribute('aria-expanded', 'false');
                };

                const openPanel = function() {
                    notificationsPanel.classList.add('is-visible');
                    notificationsPanel.setAttribute('aria-hidden', 'false');
                    notificationsToggle.setAttribute('aria-expanded', 'true');
                };

                notificationsToggle.addEventListener('click', function(event) {
                    event.stopPropagation();

                    if (notificationsPanel.classList.contains('is-visible')) {
                        closePanel();
                        return;
                    }

                    openPanel();
                });

                notificationsPanel.addEventListener('click', function(event) {
                    event.stopPropagation();
                });

                document.addEventListener('click', function() {
                    closePanel();
                });

                document.addEventListener('keydown', function(event) {
                    if (event.key === 'Escape') {
                        closePanel();
                    }
                });
            }
        });
    </script>
</main>
{% endblock %}


