{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<main class="dashboard">
    <section class="dashboard__card">
        <span class="dashboard__badge">{{ role_label }}</span>
        <h1 style="margin: 0.8rem 0 0.5rem; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.04em;">{{ title }}</h1>
        <p style="margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.6;">{{ description }}</p>

        <div class="dashboard__actions">
            <a class="button-secondary" href="{{ path('app_logout') }}">Sign out</a>
            <a class="button-secondary" href="{{ path('app_login') }}">Back to auth</a>
        </div>
    </section>
</main>
{% endblock %}