{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Dashboard
{% endblock %}

{% block page_actions %}
    <a class="btn btn-primary" href="{{ usersUrl }}">Open admin management</a>
{% endblock %}

{% block main %}
    <section class="admin-dashboard-section">
        <div class="admin-dashboard-overview">
            <div class="admin-dashboard-stats">
                <article class="admin-dashboard-stat">
                    <span>Total users</span>
                    <strong>{{ stats.users }}</strong>
                </article>
                <article class="admin-dashboard-stat">
                    <span>Total courses</span>
                    <strong>{{ stats.courses }}</strong>
                </article>
                <article class="admin-dashboard-stat">
                    <span>Total submissions</span>
                    <strong>{{ stats.submissions }}</strong>
                </article>
                <article class="admin-dashboard-stat">
                    <span>Forum posts</span>
                    <strong>{{ stats.forumPosts }}</strong>
                </article>
                <article class="admin-dashboard-stat">
                    <span>Forum comments</span>
                    <strong>{{ stats.forumComments }}</strong>
                </article>
                <article class="admin-dashboard-stat">
                    <span>Forum ratings</span>
                    <strong>{{ stats.forumRatings }}</strong>
                </article>
                <article class="admin-dashboard-stat">
                    <span>Total reclamations</span>
                    <strong>{{ stats.reclamations }}</strong>
                </article>
                <article class="admin-dashboard-stat">
                    <span>Urgent reclamations</span>
                    <strong>{{ stats.urgentReclamations }}</strong>
                </article>
                <article class="admin-dashboard-stat">
                    <span>Unread notifications</span>
                    <strong>{{ stats.unreadNotifications }}</strong>
                </article>
            </div>

        </div>

        <div class="admin-dashboard-insights-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;align-items:start;">
            <div class="admin-dashboard-prediction-panel admin-dashboard-ai-panel" style="margin-top:0;width:auto;">
                <div class="admin-dashboard-ai-panel__header">
                    <div>
                        <p class="student-profile-hero__kicker">AI prediction</p>
                        <h2>Future number of users</h2>
                    </div>
                    <div class="admin-dashboard-prediction-panel__value">
                        {{ userGrowthPrediction.projectedTotalIn6Months|default(stats.users) }} users in 6 months
                    </div>
                </div>

                <div class="admin-dashboard-prediction-panel__chart-wrap">
                    <canvas id="userGrowthPredictionChart" width="260" height="140" aria-label="User growth prediction chart" role="img"></canvas>
                </div>
            </div>

            <div class="admin-dashboard-role-chart" style="margin-top:0;width:auto;">
                <div class="admin-dashboard-ai-panel" style="margin-top:0;">
                    <div class="admin-dashboard-ai-panel__header">
                        <div>
                            <p class="student-profile-hero__kicker">User distribution</p>
                            <h2>Teachers, Students, Admins</h2>
                        </div>
                    </div>

                    <div class="admin-dashboard-role-chart__canvas-wrap">
                        <canvas id="userRolePieChart" width="140" height="140" aria-label="User roles pie chart" role="img"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-dashboard-ai-panel">
            <div class="admin-dashboard-ai-panel__header">
                <div>
                    <p class="student-profile-hero__kicker">AI recommendations</p>
                    <h2>Reclamations to process first</h2>
                </div>
                <a class="btn btn-secondary" href="{{ reclamationsUrl }}">Open prioritized list</a>
            </div>

            <div class="admin-dashboard-ai-list">
                {% for reclamation in aiRecommendations %}
                    <article class="admin-dashboard-ai-item">
                        <div>
                            <strong>#{{ reclamation.id }} - {{ reclamation.priorityLabel }}</strong>
                            <p>
                                {{ reclamation.message|striptags|slice(0, 120) }}
                                {% if reclamation.message|length > 120 %}...{% endif %}
                            </p>
                        </div>
                        <span class="admin-dashboard-ai-score">{{ reclamation.priorityScore }}/100</span>
                    </article>
                {% else %}
                    <article class="admin-dashboard-ai-item admin-dashboard-ai-item--empty">
                        <p>No reclamation available for AI prioritization.</p>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const predictionCanvas = document.getElementById('userGrowthPredictionChart');
            const chartCanvas = document.getElementById('userRolePieChart');

            if (predictionCanvas) {
                new Chart(predictionCanvas, {
                    type: 'line',
                    data: {
                        labels: {{ userGrowthPrediction.labels|default([])|json_encode|raw }},
                        datasets: [{
                            label: 'Projected users',
                            data: {{ userGrowthPrediction.predictedTotals|default([])|json_encode|raw }},
                            borderColor: '#2fa9af',
                            backgroundColor: 'rgba(77, 187, 192, 0.16)',
                            fill: true,
                            tension: 0.35,
                            pointRadius: 3,
                            pointHoverRadius: 5
                        }]
                    },
                    options: {
                        responsive: false,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return context.raw + ' users';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                ticks: {
                                    maxRotation: 0,
                                    autoSkip: true
                                },
                                grid: {
                                    display: false
                                }
                            },
                            y: {
                                beginAtZero: false,
                                grid: {
                                    color: 'rgba(191, 230, 229, 0.45)'
                                }
                            }
                        }
                    }
                });
            }

            if (chartCanvas) {
                const chartData = [
                    {{ userRoleChart.teachers|default(0) }},
                    {{ userRoleChart.students|default(0) }},
                    {{ userRoleChart.admins|default(0) }}
                ];

                new Chart(chartCanvas, {
                    type: 'pie',
                    data: {
                        labels: ['Teachers', 'Students', 'Admins'],
                        datasets: [{
                            data: chartData,
                            backgroundColor: ['#36a2eb', '#4bc0c0', '#ff6384'],
                            borderColor: '#ffffff',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: false,
                        maintainAspectRatio: true,
                        aspectRatio: 1,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return context.label + ': ' + context.raw;
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
{% endblock %}
