<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport IA Admin</title>
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            color: #102027;
            font-size: 12px;
            line-height: 1.45;
            margin: 24px;
        }

        .header {
            border-bottom: 2px solid #49bfc2;
            padding-bottom: 10px;
            margin-bottom: 16px;
        }

        .title {
            margin: 0;
            font-size: 22px;
            color: #1a474d;
        }

        .meta {
            margin-top: 4px;
            color: #4f6a70;
            font-size: 11px;
        }

        .section {
            margin-bottom: 16px;
        }

        .section h2 {
            font-size: 14px;
            margin: 0 0 8px;
            color: #1a474d;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
        }

        th,
        td {
            border: 1px solid #d8ecec;
            padding: 7px;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: #ecf9f8;
            font-weight: 700;
        }

        .summary {
            background: #f7fbfb;
            border: 1px solid #d8ecec;
            padding: 10px;
            white-space: pre-wrap;
        }

        .score {
            display: inline-block;
            padding: 2px 7px;
            border-radius: 999px;
            background: #ecf9f8;
            color: #1b5960;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <header class="header">
        <h1 class="title">Rapport IA - Dashboard Admin</h1>
        <div class="meta">Généré automatiquement le {{ generatedAt|date('d/m/Y H:i') }}</div>
    </header>

    <section class="section">
        <h2>Indicateurs clés</h2>
        <table>
            <thead>
                <tr>
                    <th>Utilisateurs</th>
                    <th>Cours</th>
                    <th>Soumissions</th>
                    <th>Posts forum</th>
                    <th>Commentaires forum</th>
                    <th>Notes forum</th>
                    <th>Réclamations</th>
                    <th>Urgentes</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ stats.users }}</td>
                    <td>{{ stats.courses }}</td>
                    <td>{{ stats.submissions }}</td>
                    <td>{{ stats.forumPosts }}</td>
                    <td>{{ stats.forumComments }}</td>
                    <td>{{ stats.forumRatings }}</td>
                    <td>{{ stats.reclamations }}</td>
                    <td>{{ stats.urgentReclamations }}</td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="section">
        <h2>Synthèse IA</h2>
        <div class="summary">{{ aiSummary }}</div>
    </section>

    <section class="section">
        <h2>Top réclamations à traiter</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Priorité</th>
                    <th>Score</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                {% for reclamation in topReclamations %}
                    <tr>
                        <td>#{{ reclamation.id }}</td>
                        <td>{{ reclamation.priorityLabel }}</td>
                        <td><span class="score">{{ reclamation.priorityScore }}/100</span></td>
                        <td>{{ reclamation.message|striptags|slice(0, 220) }}{% if reclamation.message|length > 220 %}...{% endif %}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">Aucune réclamation prioritaire disponible.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
</body>
</html>
